<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GCAR — náhradní díly pro osobní a užitkové vozy | Kroměříž, Staré Město</title>
<meta name="description" content="Dovoz a distribuce náhradních dílů pro osobní a užitkové vozy. Rozvoz do autoservisů a obchodů na Kroměřížsku a Uherskohradišťsku.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  /* odebráno přímo z loga: navy #1A243D, červená #DB343E */
  --ink:#1A243D;
  --ink-deep:#121A2C;
  --ink-soft:#3D4763;
  --steel:#6B7593;
  --zinc:#D4D9E3;
  --zinc-light:#E7EAF1;
  --paper:#F0F2F6;
  --white:#FFFFFF;
  --red:#DB343E;
  --red-dark:#B32830;
  --open:#1C7A4C;

  --display:"Archivo","Arial Narrow",Arial,sans-serif;
  --body:"IBM Plex Sans","Segoe UI",Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,monospace;

  --wrap:1220px;
  --gut:clamp(18px,4vw,44px);
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--body);font-size:16.5px;line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--red);outline-offset:2px}

.wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--gut)}

h1,h2,h3,h4{font-family:var(--display);margin:0;letter-spacing:-.02em;line-height:1.05}
h2{font-size:clamp(28px,4vw,44px);font-weight:700}
h3{font-size:clamp(19px,2.2vw,23px);font-weight:700;letter-spacing:-.01em;line-height:1.2}
p{margin:0 0 1em}
.lede{font-size:clamp(17px,1.9vw,20px);color:var(--ink-soft);max-width:62ch;line-height:1.5}

/* ---------- utility bar ---------- */
.util{background:var(--ink-deep);color:#A9B2CA;font-size:13.5px}
.util .wrap{display:flex;gap:26px;align-items:center;min-height:38px;flex-wrap:wrap}
.util a{text-decoration:none}
.util a:hover{color:#fff}
.util .sep{margin-left:auto}

/* ---------- header ---------- */
header{background:var(--white);border-bottom:1px solid var(--zinc);position:sticky;top:0;z-index:50}
header .wrap{display:flex;align-items:center;gap:14px;min-height:76px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;flex:0 0 auto}
.brand img{width:148px;height:auto}
.brand em{
  font-style:normal;font-size:13px;color:var(--steel);font-weight:500;
  padding-left:12px;border-left:1px solid var(--zinc);line-height:1.2;
}
@media (max-width:860px){.brand em{display:none}}
nav{margin-left:auto;display:flex;gap:2px}
nav a{
  text-decoration:none;font-weight:500;font-size:15.5px;color:var(--ink-soft);
  padding:9px 13px;border-radius:3px;
}
nav a:hover{color:var(--ink);background:var(--zinc-light)}
nav a[aria-current]{color:var(--ink);box-shadow:inset 0 -3px 0 var(--red)}

.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  font-family:var(--body);font-weight:600;font-size:15.5px;
  padding:12px 22px;border:1px solid transparent;border-radius:3px;
  text-decoration:none;cursor:pointer;background:none;
}
.btn-red{background:var(--red);color:#fff}
.btn-red:hover{background:var(--red-dark)}
.btn-line{border-color:var(--ink);color:var(--ink)}
.btn-line:hover{background:var(--ink);color:#fff}
.btn-ghost{border-color:var(--zinc);background:#fff;color:var(--ink)}
.btn-ghost:hover{border-color:var(--ink)}
.btn-lg{padding:15px 28px;font-size:16.5px}
.nav-cta{margin-left:14px}
.burger{display:none;margin-left:auto;background:none;border:1px solid var(--zinc);border-radius:3px;padding:10px 12px;font:inherit;cursor:pointer}

/* mobilní menu */
.bars{display:block;width:20px}
.bars i{display:block;height:2px;background:var(--ink);margin:4px 0;border-radius:2px;transition:transform .2s,opacity .2s}
.burger[aria-expanded="true"] .bars i:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger[aria-expanded="true"] .bars i:nth-child(2){opacity:0}
.burger[aria-expanded="true"] .bars i:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.mobmenu{
  position:sticky;top:76px;z-index:49;background:#fff;
  border-bottom:1px solid var(--zinc);padding:10px var(--gut) 20px;
}
.mobmenu nav{display:block;margin:0 0 14px}
.mobmenu nav a{
  display:block;padding:14px 2px;font-size:17px;font-weight:500;
  color:var(--ink);text-decoration:none;border-bottom:1px solid var(--zinc-light);border-radius:0;
}
.mobmenu nav a:hover{background:none}
@media (min-width:761px){.mobmenu{display:none}}
@media (prefers-reduced-motion:no-preference){
  .mobmenu{animation:drop .22s ease-out both}
  @keyframes drop{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
}

/* mobilní lišta pro volání */
.callbar{
  display:none;position:fixed;left:0;right:0;bottom:0;z-index:60;
  background:var(--ink);border-top:1px solid #333E5C;
  padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  gap:10px;
}
.callbar a{
  flex:1;display:flex;align-items:center;justify-content:center;gap:8px;
  text-decoration:none;font-weight:600;font-size:16px;padding:14px 10px;border-radius:3px;
}
.callbar .c-km{background:var(--red);color:#fff}
.callbar .c-uh{border:1px solid #4A5578;color:#fff}
.callbar small{display:block;font-size:11.5px;font-weight:500;opacity:.75;letter-spacing:.02em}

/* ---------- hero ---------- */
.hero{background:var(--white);border-bottom:1px solid var(--zinc);overflow:hidden;position:relative}
.hero::before{
  content:"";position:absolute;right:-170px;top:-140px;width:520px;height:520px;
  background:radial-gradient(circle at 50% 50%, rgba(26,36,61,.05) 0 68%, transparent 69%);
  border-radius:50%;pointer-events:none;
}
.hero .wrap{display:grid;grid-template-columns:1.35fr .9fr;gap:clamp(30px,5vw,70px);padding-top:clamp(42px,6vw,76px);padding-bottom:clamp(42px,6vw,72px);align-items:start}
.hero h1{
  font-size:clamp(38px,6.1vw,70px);font-weight:800;letter-spacing:-.035em;
  max-width:16ch;margin-bottom:22px;
}
.hero .lede{margin-bottom:30px}

.finder{border:2px solid var(--ink);border-radius:4px;background:#fff;display:flex;overflow:hidden;max-width:560px}
.finder input{
  flex:1;border:0;padding:17px 18px;font:inherit;font-size:16.5px;min-width:0;background:transparent;
}
.finder input:focus{outline:none}
.finder button{border:0;background:var(--red);color:#fff;font:inherit;font-weight:600;padding:0 26px;cursor:pointer;font-size:16px}
.finder button:hover{background:var(--red-dark)}
.finder-note{font-size:14px;color:var(--steel);margin:11px 0 0}
.finder-note a{color:var(--ink);text-underline-offset:3px}

/* pobočky panel */
.branches{border:1px solid var(--zinc);background:var(--paper);border-radius:4px}
.branch{padding:20px 22px;border-bottom:1px solid var(--zinc)}
.branch:last-child{border-bottom:0}
.branch-top{display:flex;align-items:center;gap:10px;margin-bottom:3px}
.branch h3{font-size:19px}
.dot{width:9px;height:9px;border-radius:50%;background:var(--steel);flex:0 0 auto}
.dot.is-open{background:var(--open);box-shadow:0 0 0 3px rgba(28,122,76,.18)}
.status{font-size:13.5px;font-weight:600;color:var(--steel);margin-left:auto}
.status.is-open{color:var(--open)}
.branch address{font-style:normal;font-size:14.5px;color:var(--ink-soft);margin:6px 0 12px}
.branch .tels{display:flex;flex-wrap:wrap;gap:8px}
.branch .tels a{
  font-family:var(--mono);font-size:14px;text-decoration:none;
  border:1px solid var(--zinc);background:#fff;border-radius:3px;padding:6px 11px;
}
.branch .tels a:hover{border-color:var(--ink)}
.hours{padding:15px 22px;font-size:13.5px;color:var(--steel);background:var(--zinc-light);border-radius:0 0 3px 3px}
.hours b{color:var(--ink);font-weight:600}

/* ---------- pruh čísel ---------- */
.strip{background:var(--ink);color:#fff}
.strip .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#2E3855;border-left:1px solid #2E3855;border-right:1px solid #2E3855;padding:0}
.stat{background:var(--ink);padding:28px clamp(16px,2.2vw,28px)}
.stat b{display:block;font-family:var(--display);font-weight:700;font-size:clamp(26px,3.3vw,38px);letter-spacing:-.03em;margin-bottom:4px}
.stat span{font-size:14.5px;color:#9AA4C0;line-height:1.35;display:block}

/* ---------- sekce ---------- */
section{padding:clamp(52px,7vw,90px) 0}
.sec-head{display:flex;align-items:flex-end;gap:24px;margin-bottom:34px;flex-wrap:wrap}
.sec-head .lede{margin:14px 0 0}
.sec-head .more{margin-left:auto;text-decoration:none;font-weight:600;font-size:15.5px;border-bottom:2px solid var(--red);padding-bottom:2px;white-space:nowrap}

.about{background:var(--white);border-bottom:1px solid var(--zinc);padding-top:clamp(46px,6vw,74px);padding-bottom:clamp(46px,6vw,74px)}
.about .wrap{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(26px,5vw,64px);align-items:start}
.about h2{max-width:14ch}
.about p{color:var(--ink-soft);font-size:17px;max-width:62ch}
@media (max-width:860px){.about .wrap{grid-template-columns:1fr}}

/* sortiment */
.cats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--zinc);border:1px solid var(--zinc)}
.cat{background:#fff;padding:26px;text-decoration:none;display:flex;flex-direction:column;min-height:210px}
.cat:hover{background:#fff;box-shadow:inset 0 0 0 2px var(--red)}
.cat h3{margin-bottom:9px}
.cat p{font-size:15px;color:var(--ink-soft);margin:0}
.cat .tags{margin-top:auto;padding-top:16px;font-size:13.5px;color:var(--steel);line-height:1.5}
.cat.is-wide{grid-column:span 2}
.cat .parts{margin-top:auto;padding-top:16px;display:flex;flex-wrap:wrap;gap:6px}
.cat .parts i{
  font-style:normal;font-size:13.5px;border:1px solid var(--zinc);
  border-radius:99px;padding:3px 11px;color:var(--ink-soft);
}

/* rozvoz */
.delivery{background:var(--white);border-top:1px solid var(--zinc);border-bottom:1px solid var(--zinc)}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,40px);counter-reset:s}
.step{position:relative;padding-top:22px;border-top:3px solid var(--ink)}
.step:last-child{border-top-color:var(--red)}
.step b{
  font-family:var(--mono);font-size:13px;color:var(--steel);display:block;margin-bottom:10px;
}
.step h3{margin-bottom:8px}
.step p{font-size:15.5px;color:var(--ink-soft);margin:0}

/* zboží */
.goods{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--zinc);border:1px solid var(--zinc)}
.good{background:#fff;padding:20px;display:flex;flex-direction:column;text-decoration:none}
.good .ph{
  aspect-ratio:4/3;background:var(--zinc-light);border-radius:3px;margin-bottom:16px;
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.good .ph img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.good .ph span{font-family:var(--mono);font-size:12px;color:var(--steel)}
.good .code{font-family:var(--mono);font-size:12.5px;color:var(--steel);margin-bottom:6px}
.good h3{font-size:17px;line-height:1.3;margin-bottom:auto}
.good .price{
  margin-top:16px;padding-top:14px;border-top:1px solid var(--zinc-light);
  display:flex;align-items:baseline;gap:8px;
}
.good .price b{font-family:var(--display);font-weight:700;font-size:22px;letter-spacing:-.02em}
.good .price span{font-size:13px;color:var(--steel)}
.good:hover h3{color:var(--red)}

/* služby */
.svc{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.svc a{
  background:#fff;border:1px solid var(--zinc);border-radius:4px;padding:22px;
  text-decoration:none;display:block;
}
.svc a:hover{border-color:var(--ink)}
.svc h3{font-size:18px;margin-bottom:7px}
.svc p{font-size:14.5px;color:var(--ink-soft);margin:0}

/* kontakt */
.contact{background:var(--ink);color:#fff}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4vw,56px)}
.contact h2{color:#fff;margin-bottom:16px}
.contact .lede{color:#A3ACC6}
.ccard{border:1px solid #333E5C;border-radius:4px;padding:24px;margin-bottom:16px}
.ccard h3{color:#fff;margin-bottom:8px}
.ccard address{font-style:normal;color:#A3ACC6;font-size:15px;margin-bottom:14px}
.ccard .tels{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.ccard .tels a{font-family:var(--mono);font-size:14.5px;text-decoration:none;border:1px solid #3B4666;border-radius:3px;padding:7px 12px;color:#fff}
.ccard .tels a:hover{background:var(--red);border-color:var(--red)}
.ccard .mail{color:#fff;font-size:15px;text-underline-offset:3px}

/* footer */
footer{background:var(--ink-deep);color:#7E88A5;font-size:14px;padding:26px 0}
footer .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}
footer a{text-decoration:none}
footer a:hover{color:#fff}
footer .sep{margin-left:auto}

/* ---------- responzivita ---------- */
@media (max-width:980px){
  .hero .wrap{grid-template-columns:1fr}
  .strip .wrap{grid-template-columns:1fr 1fr}
  .cats,.goods{grid-template-columns:1fr 1fr}
  .cat.is-wide{grid-column:span 2}
  .steps{grid-template-columns:1fr;gap:26px}
  .svc{grid-template-columns:1fr 1fr}
  .contact .wrap{grid-template-columns:1fr}
}
@media (max-width:760px){
  body{padding-bottom:78px}
  .callbar{display:flex}
  nav{display:none}
  .nav-cta{display:none}
  .burger{display:block}
  .util .wrap{min-height:34px;font-size:12.5px;gap:16px}
  .cats,.goods,.svc{grid-template-columns:1fr}
  .cat.is-wide{grid-column:span 1}
  .strip .wrap{grid-template-columns:1fr 1fr}
  .finder{flex-direction:column;border-radius:4px}
  .finder button{padding:16px}
  .branch .tels a{padding:10px 14px;font-size:15px}
  .util .wrap{justify-content:space-between}
  .util .sep{display:none}
  .sec-head .more{margin-left:0}
  footer .wrap{flex-direction:column;align-items:flex-start;gap:8px}
  footer .sep{margin-left:0}
}
@media (prefers-reduced-motion:no-preference){
  .hero h1,.hero .lede,.hero .finder,.hero .finder-note,.hero .branches{
    animation:rise .55s cubic-bezier(.22,.8,.3,1) both;
  }
  .hero .lede{animation-delay:.07s}
  .hero .finder{animation-delay:.13s}
  .hero .finder-note{animation-delay:.17s}
  .hero .branches{animation-delay:.2s}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
}
</style>
</head>
