<script>
// Mobilní menu
(function(){
  var b = document.getElementById('burger'), m = document.getElementById('mobmenu');
  if(!b || !m) return;
  function set(open){
    b.setAttribute('aria-expanded', open ? 'true' : 'false');
    b.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
    m.hidden = !open;
  }
  b.addEventListener('click', function(){ set(m.hidden); });
  m.addEventListener('click', function(e){ if(e.target.tagName === 'A') set(false); });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape' && !m.hidden){ set(false); b.focus(); }
  });
  // při přechodu na desktop panel zavřít
  matchMedia('(min-width:761px)').addEventListener('change', function(e){ if(e.matches) set(false); });
})();

// Živý stav otevírací doby pro obě pobočky
(function(){
  function open(now){
    var d = now.getDay(), m = now.getHours()*60 + now.getMinutes();
    if(d >= 1 && d <= 5) return m >= 480 && m < 1020;   // Po–Pá 8:00–17:00
    if(d === 6) return m >= 540 && m < 600;             // So 9:00–10:00
    return false;
  }
  function nextText(now){
    var d = now.getDay(), m = now.getHours()*60 + now.getMinutes();
    if(d>=1 && d<=5 && m < 480) return 'Otevřeme v 8:00';
    if(d>=1 && d<=4) return 'Otevřeme zítra v 8:00';
    if(d===5) return 'Otevřeme v sobotu, po domluvě';
    if(d===6) return m < 540 ? 'Otevřeme v 9:00' : 'Otevřeme v pondělí v 8:00';
    return 'Otevřeme v pondělí v 8:00';
  }
  function render(){
    var now = new Date(), isOpen = open(now);
    document.querySelectorAll('[data-branch]').forEach(function(el){
      var dot = el.querySelector('.dot'), st = el.querySelector('.status');
      dot.classList.toggle('is-open', isOpen);
      st.classList.toggle('is-open', isOpen);
      st.textContent = isOpen ? 'Teď otevřeno' : nextText(now);
    });
  }
  render();
  setInterval(render, 60000);
})();
</script>
